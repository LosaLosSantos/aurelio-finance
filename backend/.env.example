# Aurelio's backend settings. Copy this file to backend/.env only when you
# want to override a default. Model access comes from the GitHub Copilot account
# authenticated on this machine (`copilot login`); no API key belongs here.

# Default Copilot model for the chat and every analysis role.
# Use a model id offered by the authenticated account (`copilot --banner`).
# Default if empty: claude-opus-5.5
COPILOT_MODEL=

# Optional: give each role of the analysis its own model. Different models
# bring different blind spots, which is the point of a panel; leaving these
# empty runs every role on COPILOT_MODEL, and the analysis still works because
# the asymmetry is in the context each role receives, not in the weights.
#   analyst: judges the portfolio blind (quantitative work)
#   confidant: knows the person, never sees the figures (reads people, words)
COPILOT_ANALYST_MODEL=
COPILOT_CONFIDANT_MODEL=

# Optional: model used by the chat when none is picked in its menu. Falls back
# to COPILOT_MODEL.
COPILOT_CHAT_MODEL=

# Optional: model used for isolated web retrieval. The search request carries
# only its query, not the conversation or financial records.
# Default if empty: claude-haiku-5.5
COPILOT_SEARCH_MODEL=

# Optional: another SQLite database. Default: backend/data.db.
# ./start.ps1 -Demo and ./start.sh --demo point it at backend/demo.db for you.
# DATABASE_URL=sqlite:///path/to/another.db
